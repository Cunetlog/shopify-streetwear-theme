<section class="search-page">
  <header class="search-page__header">
    <h1 class="search-page__title">{{ 'search.title' | t }}</h1>

    <form
      class="search-page__form"
      action="{{ routes.search_url }}"
      method="get"
      role="search"
    >
      <input
        type="hidden"
        name="type"
        value="product"
      >

      <label
        class="visually-hidden"
        for="SearchInput"
      >
        {{ 'search.products_placeholder' | t }}
      </label>

      <input
        id="SearchInput"
        class="search-page__input"
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="Search products"
        autocomplete="off"
      >

      <button
        class="search-page__submit"
        type="submit"
      >
        {{ 'search.submit' | t }}
      </button>
    </form>

    {% if search.performed %}
      <div
        class="search-page__summary"
        aria-live="polite"
      >
        {% if search.results_count > 0 %}
          {{ search.results_count }}
          {% if search.results_count == 1 %}
            result for
          {% else %}
            results for
          {% endif %}
          “{{ search.terms | escape }}”
        {% else %}
          No results for “{{ search.terms | escape }}”
        {% endif %}
      </div>
    {% endif %}
  </header>

  {% if search.performed and search.results_count > 0 %}
    {% paginate search.results by 20 %}
      <div class="product-grid">
        {% for result in search.results %}
          {% if result.object_type == 'product' %}
            {% render 'product-card', product: result %}
          {% endif %}
        {% endfor %}
      </div>

      {% if paginate.pages > 1 %}
        <div class="search-pagination">
          {{ paginate | default_pagination }}
        </div>
      {% endif %}
    {% endpaginate %}
  {% endif %}
</section>

{% schema %}
{
  "name": "Search",
  "settings": []
}
{% endschema %}
