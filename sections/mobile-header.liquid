<header class="mobile-header">
  <button
    class="mobile-header__menu-button"
    type="button"
    aria-label="Open menu"
    aria-haspopup="dialog"
    aria-controls="MobileMenu"
    data-mobile-menu-open
  >
    {% render 'icon-menu' %}
  </button>

  <a
    class="mobile-header__logo"
    href="{{ routes.root_url }}"
    aria-label="{{ shop.name | escape }}"
  >
    {% if settings.logo != blank %}
      {{
        settings.logo
        | image_url: width: 240
        | image_tag: class: 'mobile-header__logo-image', widths: '80, 120, 160, 240', alt: shop.name, loading: 'eager'
      }}
    {% else %}
      <span class="mobile-header__logo-text">
        {{ shop.name }}
      </span>
    {% endif %}
  </a>

  <a
    class="mobile-header__cart"
    href="{{ routes.cart_url }}"
    aria-label="Cart, {{ cart.item_count }} items"
    data-cart-open
  >
    {{ 'theme.bag' | t }}
    <span aria-hidden="true"
      >(<span data-cart-count>{{ cart.item_count }}</span>)</span
    >
  </a>
</header>

{% schema %}
{
  "name": "Mobile header",
  "settings": []
}
{% endschema %}
