<footer class="site-footer">
  <div class="site-footer__inner">
    <details class="site-footer__group site-footer__group--newsletter">
      <summary class="site-footer__summary">
        {{ 'footer.newsletter' | t }}
      </summary>

      <div class="site-footer__content">
        {% render 'newsletter-form' %}
      </div>
    </details>

    <details class="site-footer__group site-footer__group--legal">
      <summary class="site-footer__summary">
        {{ 'footer.terms' | t }}
      </summary>

      {% if settings.footer_legal_menu != blank %}
        <nav
          class="site-footer__content site-footer__legal"
          aria-label="{{ 'footer.terms' | t }}"
        >
          <ul role="list">
            {% for link in settings.footer_legal_menu.links %}
              <li>
                <a href="{{ link.url }}">
                  {{ link.title }}
                </a>
              </li>
            {% endfor %}
          </ul>
        </nav>
      {% endif %}
    </details>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": []
}
{% endschema %}
