<!doctype html>
<html
  class="no-js"
  lang="{{ request.locale.iso_code }}"
>
  <head>
    <meta charset="utf-8">

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    >

    <meta
      name="theme-color"
      content="{{ settings.color_background | default: '#ffffff' }}"
    >

    <link
      rel="canonical"
      href="{{ canonical_url }}"
    >

    <title>
      {{ page_title }}

      {% if current_tags %}
        – {{ current_tags | join: ', ' }}
      {% endif %}

      {% if current_page != 1 %}
        – Page {{ current_page }}
      {% endif %}

      {% unless page_title contains shop.name %}
        – {{ shop.name }}
      {% endunless %}
    </title>

    {% if page_description %}
      <meta
        name="description"
        content="{{ page_description | escape }}"
      >
    {% endif %}

    <script>
      document.documentElement.classList.remove('no-js');
      document.documentElement.classList.add('js');

      (() => {
        const storageKey = 'qt8-theme';

        try {
          const savedTheme = localStorage.getItem(storageKey);

          if (savedTheme === 'light' || savedTheme === 'dark') {
            document.documentElement.dataset.theme = savedTheme;
            return;
          }

          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.dataset.theme = prefersDark ? 'dark' : 'light';
        } catch (error) {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>

    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ 'responsive.css' | asset_url | stylesheet_tag }}

    {% if settings.favicon != blank %}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 64, height: 64 }}"
      >
    {% endif %}

    {{ content_for_header }}
  </head>

  <body>
    <a
      class="skip-link"
      href="#MainContent"
    >
      Skip to content
    </a>

    {% section 'desktop-sidebar' %}
    {% section 'mobile-header' %}
    {% section 'mobile-menu' %}
    {% section 'cart-drawer' %}

    <main
      id="MainContent"
      class="site-main"
      role="main"
      tabindex="-1"
    >
      {{ content_for_layout }}
    </main>

    <script
      src="{{ 'theme.js' | asset_url }}"
      defer
    ></script>

    <script
      src="{{ 'menu.js' | asset_url }}"
      defer
    ></script>

    <script
      src="{{ 'theme-toggle.js' | asset_url }}"
      defer
    ></script>
    <script
      src="{{ 'cart.js' | asset_url }}"
      defer
    ></script>
    <script
      src="{{ 'localization.js' | asset_url }}"
      defer
    ></script>
  </body>
</html>
